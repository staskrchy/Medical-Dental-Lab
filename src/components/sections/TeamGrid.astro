---
import { Image } from 'astro:assets';
import team from '../../content/team';
---

<section class="team" id="specialists">
  <div class="head" data-reveal>
    <h2 class="title">{team.title}</h2>
    <p class="text">{team.text}</p>
  </div>

  {team.rows.map((row) => (
    <ul class="row" data-team-row>
      {row.map((p) => (
        <li class="card" data-team-card>
          <Image src={p.photo} alt={p.name} class="photo" quality={90} />
          <div class="info">
            <p class="name">{p.name}</p>
            <p class="practice">{p.practice}</p>
            <p class="role">{p.role}</p>
          </div>
        </li>
      ))}
    </ul>
  ))}
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Картки з'являються зліва направо: спершу ряд із двох, нижче — ряд із трьох, кожен коли доходить до екрана
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('[data-team-row]').forEach((row) => {
      gsap.from(row.querySelectorAll('[data-team-card]'), {
        autoAlpha: 0,
        x: -40,
        duration: 0.8,
        ease: 'power3.out',
        stagger: 0.25,
        scrollTrigger: { trigger: row, start: 'top 80%', once: true },
      });
    });
  });
</script>

<style>
  /* Десктоп (макет: 1040–3002 px). Мобільну версію додамо окремо. */
  @media (min-width: 1024px) {
    .team {
      position: relative;
      z-index: 1; /* наїжджає на зафіксований перший екран */
      padding: var(--space-80) var(--gutter) var(--space-80);
      background: var(--surface-soft);
      color: var(--text-primary);
    }
    .head {
      padding-bottom: var(--space-48);
    }
    .title {
      font-size: var(--fs-64);
      font-weight: 400;
      line-height: var(--lh-tight);
      letter-spacing: var(--ls-tight);
      text-transform: capitalize;
    }
    .text {
      max-width: 33.75rem; /* 538px з макета */
      margin-top: var(--space-24);
      font-size: var(--fs-20);
      line-height: var(--lh-loose);
      letter-spacing: var(--ls-none);
      color: var(--text-secondary);
      text-wrap: pretty;
    }

    /* Ряд карток між тонкими лініями, 3 колонки по 492px */
    .row {
      display: grid;
      grid-template-columns: repeat(3, 30.75rem);
      gap: 0.625rem; /* 10px з макета */
      padding-block: var(--space-24) var(--space-32);
      border-top: 0.5px solid var(--color-slate-400);
      list-style: none;
    }
    .row:last-child {
      padding-bottom: var(--space-24);
      border-bottom: 0.5px solid var(--color-slate-400);
    }
    .card {
      display: flex;
      flex-direction: column;
      aspect-ratio: 492 / 715;
      padding-top: 3px;
      background: var(--surface-neutral-100);
    }
    .photo {
      width: 100%;
      height: auto;
      aspect-ratio: 492 / 593;
    }
    .info {
      padding: var(--space-24) var(--space-8) 0;
    }
    .name {
      font-size: var(--fs-24);
      line-height: var(--lh-tight);
      letter-spacing: var(--ls-tight);
    }
    .practice {
      margin-top: var(--space-4);
      font-size: var(--fs-18);
      line-height: var(--lh-tight);
      letter-spacing: var(--ls-tight);
      text-transform: lowercase;
    }
    .role {
      margin-top: var(--space-12);
      font-size: var(--fs-16);
      line-height: var(--lh-tight);
      letter-spacing: var(--ls-tight);
      opacity: 0.41;
    }
  }
</style>
