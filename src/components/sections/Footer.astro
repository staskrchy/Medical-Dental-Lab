---
import { Image } from 'astro:assets';
import data from '../../content/footer';
---

<footer class="footer">
  <div class="top">
    <nav class="nav">
      {data.nav.map((item) => <a class="link" href={item.href}>{item.label}</a>)}
    </nav>

    <div class="features">
      <ul class="feature-list">
        {data.features.map((f) => <li>{f}</li>)}
      </ul>
      <p class="ai">
        {data.ai.label}
        <Image src={data.ai.icons} alt="" class="ai-icons" />
      </p>
    </div>

    <!-- TODO: підключити підписку на розсилку -->
    <form class="newsletter" method="post" novalidate data-newsletter>
      <p class="newsletter-text">{data.newsletter.text}</p>
      <label class="email">
        <Image src={data.newsletter.icon} alt="" class="email-icon" />
        <span class="visually-hidden">{data.newsletter.placeholder}</span>
        <input class="email-input" type="email" name="email" placeholder={data.newsletter.placeholder} autocomplete="email" required />
      </label>
      <button class="link subscribe" type="submit">{data.newsletter.submit}</button>
    </form>
  </div>

  <p class="disclaimer">{data.disclaimer}</p>

  <ul class="legal">
    {data.legal.map((l) => <li>{l.href ? <a class="link" href={l.href}>{l.label}</a> : l.label}</li>)}
  </ul>

  <div class="wordmark">
    <span>{data.wordmark[0]}</span>
    <Image src={data.logo.src} alt={data.logo.alt} class="logo" />
    <span>{data.wordmark[1]}</span>
  </div>
</footer>

<script>
  // Як у формі контактів: без попапа браузера, некоректний email — червоним
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input');
    if (!input) return;
    const check = () => input.classList.toggle('is-invalid', !input.checkValidity());
    input.addEventListener('input', () => input.classList.contains('is-invalid') && check());
    form.addEventListener('submit', (event) => {
      check();
      if (!form.checkValidity()) {
        event.preventDefault();
        input.focus();
      }
    });
  });
</script>

<style>
  /* Мобільний (макет: 11084–12604 px). Порядок блоків інший, ніж на десктопі,
     тому обгортки розгортаються (display: contents), а елементи ставляться через order. */
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    padding: calc(var(--space-56) + var(--space-4)) var(--space-24) var(--space-16);
    background: var(--surface-inverse);
    color: var(--text-inverse);
  }
  .top,
  .features,
  .legal,
  .wordmark { display: contents; }

  /* Підкреслення зліва направо при наведенні, як у хедері */
  .link {
    position: relative;
    width: fit-content;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.1em;
    border-bottom: var(--border-width) solid currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease);
  }
  .link:hover::after,
  .link:focus-visible::after { transform: scaleX(1); }

  /* 1. Меню + логотип праворуч */
  .nav {
    order: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
    font-size: var(--fs-32);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
  }
  .logo {
    order: 2;
    width: calc(var(--space-48) - 1px); /* 47 × 58 px з макета */
    height: auto;
  }

  /* 2. © і All Rights Reserved в один рядок */
  .legal li {
    width: 50%;
    font-size: var(--fs-12);
    line-height: var(--lh-loose);
    letter-spacing: var(--ls-none);
    opacity: 0.34;
    list-style: none;
  }
  .legal li:nth-child(1),
  .legal li:nth-child(2) { order: 3; margin-top: var(--space-48); }
  .legal li:nth-child(2n) { text-align: right; }
  .legal li:nth-child(2n) .link { margin-left: auto; }

  /* 3. Переваги і «Ask your AI» */
  .feature-list {
    order: 4;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    margin-top: var(--space-44);
    list-style: none;
    font-size: var(--fs-20);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
  }
  .ai {
    order: 5;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: var(--space-48);
    font-size: var(--fs-17);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
  }
  .ai-icons {
    width: 6.4375rem; /* 103px з макета */
    height: auto;
  }

  /* 4. Дисклеймер і гарантія */
  .disclaimer {
    order: 6;
    width: 100%;
    margin-top: var(--space-40);
    font-size: calc(var(--fs-20) / 2); /* 10px з макета */
    line-height: var(--lh-loose);
    letter-spacing: var(--ls-none);
    opacity: 0.34;
    text-wrap: pretty;
  }
  .legal li:nth-child(3) {
    order: 7;
    width: 100%;
    margin-top: var(--space-40);
  }

  /* 5. Розсилка */
  .newsletter {
    order: 8;
    width: 100%;
    margin-top: calc(var(--space-56) + var(--space-4));
  }
  .newsletter-text {
    font-size: var(--fs-16);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
  }
  .email {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    margin-top: var(--space-32);
    padding-bottom: var(--space-12);
    border-bottom: 0.5px solid color-mix(in srgb, var(--border-neutral-0) 40%, transparent);
    transition: border-color var(--duration) var(--ease);
  }
  .email-icon {
    flex: none;
    width: var(--space-24);
    height: auto;
  }
  .email-input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    font-size: var(--fs-20);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    color: var(--text-inverse);
    outline: none;
  }
  .email-input::placeholder { color: color-mix(in srgb, var(--text-inverse) 21%, transparent); }
  .email:focus-within { border-bottom-color: var(--border-neutral-0); }
  .email:has(.is-invalid) { border-bottom-color: var(--border-error); }
  .email-input.is-invalid,
  .email-input.is-invalid::placeholder { color: var(--border-error); }
  .subscribe {
    margin-top: var(--space-56);
    font-family: var(--font-display);
    font-size: var(--fs-32);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    text-decoration: underline;
    text-decoration-thickness: var(--border-width);
    text-underline-offset: 0.15em;
  }
  .subscribe::after { display: none; }

  /* 6. Privacy Policy і Terms в один рядок */
  .legal li:nth-child(4),
  .legal li:nth-child(5) { order: 9; margin-top: var(--space-56); }

  /* 7. Великий напис у два рядки */
  .wordmark span {
    order: 10;
    width: 100%;
    font-size: var(--fs-64);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    white-space: nowrap;
  }
  .wordmark span:first-child { margin-top: var(--space-16); }
  .wordmark span:last-child {
    margin-top: calc(var(--space-12) * -1);
    text-align: center;
  }

  /* Десктоп (макет: футер 10678–11683 px, 1920 × 1005) */
  @media (min-width: 1024px) {
    /* Скидаємо мобільний порядок: на десктопі блоки йдуть як у розмітці */
    .nav,
    .logo,
    .feature-list,
    .ai,
    .disclaimer,
    .newsletter,
    .legal li:nth-child(n),
    .wordmark span { order: 0; }
    .footer {
      display: flex;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      aspect-ratio: 1920 / 1005;
      padding: calc(var(--space-120) + var(--space-32)) var(--gutter) var(--space-40);
    }
    .top {
      display: grid;
      grid-template-columns: 492fr 643fr 705fr; /* колонки з макета */
      align-items: start;
    }
    .features {
      display: flex;
      flex-direction: column;
      gap: calc(var(--space-56) + var(--space-4));
      padding-top: var(--space-12);
    }
    .legal {
      display: flex;
      gap: calc(var(--space-44) + var(--space-4));
      margin-top: var(--space-16);
    }
    .wordmark {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
    }

    .nav {
      flex: none;
      font-size: var(--fs-36);
    }
    .feature-list {
      width: auto;
      margin-top: 0;
    }
    .ai {
      width: auto;
      justify-content: flex-start;
      gap: var(--space-16);
      margin-top: 0;
      font-size: var(--fs-20);
    }
    .ai-icons { width: 7.35rem; /* 117px з макета */ }

    .disclaimer {
      margin-top: calc(var(--space-80) + var(--space-8));
      font-size: var(--fs-18);
    }
    .legal li,
    .legal li:nth-child(n) {
      width: auto;
      margin-top: 0;
      text-align: left;
      font-size: var(--fs-18);
    }

    .newsletter {
      max-width: 44rem; /* 705px з макета */
      margin-top: 0;
      padding-top: var(--space-12);
    }
    .newsletter-text {
      max-width: 31.25rem; /* 499px з макета */
      font-size: var(--fs-20);
    }
    .email { max-width: 31.5rem; /* 502px з макета */ }
    .subscribe { margin-top: var(--space-24); }

    .wordmark span,
    .wordmark span:first-child,
    .wordmark span:last-child {
      width: auto;
      margin-top: 0;
      text-align: left;
    }
    .logo { width: 5.4375rem; /* 87 × 106 px, як у макеті; файл уже в цих пропорціях */ }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
