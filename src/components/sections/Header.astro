---
import { Image } from 'astro:assets';
import header from '../../content/header';
import MobileMenu from '../ui/MobileMenu.astro';
---

<header class="header">
  <a class="logo" href={header.logo.href}>
    <Image src={header.logo.src} alt={header.logo.alt} class="logo-img" width={72} />
    <span class="logo-text">{header.logo.text}</span>
  </a>

  <nav class="nav">
    {header.nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="meta">
    <a class="phone" href={header.phone.href}>{header.phone.label}</a>
    <a class="booking" href={header.booking.href} data-booking-open>
      <Image src={header.booking.icon} alt="" class="booking-icon" />
      {header.booking.label}
    </a>
  </div>

  <!-- Мобільний: бургер відкриває меню -->
  <button class="burger" type="button" aria-label={header.menuLabel} data-menu-open>
    <svg viewBox="0 0 46 36" fill="currentColor" aria-hidden="true">
      <path d="M0 0h46v5.14H0zM0 15.43h46v5.14H0zM0 30.86h46V36H0z" />
    </svg>
  </button>
</header>

<MobileMenu />

<style>
  /* Мобільний (макет 375): лише логотип і бургер поверх фото */
  .header {
    position: absolute;
    inset: 15px var(--space-24) auto;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .logo-img {
    display: block;
    height: var(--space-44);
    width: auto;
    aspect-ratio: 36 / 43; /* рамка лого з макета; файл уже в цих пропорціях */
  }
  .logo-text,
  .nav,
  .meta { display: none; }
  .burger {
    width: calc(var(--space-44) + 2px); /* 46 × 36 з макета */
    margin-top: var(--space-8);
    padding: 0;
    border: 0;
    background: none;
    color: var(--icon-inverse);
    cursor: pointer;
  }
  .burger svg { display: block; width: 100%; }

  /* Десктоп (макет: Group 124, 132:443) */
  @media (min-width: 1024px) {
    .burger { display: none; }
    .logo-text { display: inline; }
    .header {
      position: absolute;
      inset: var(--space-32) var(--gutter) auto var(--space-32);
      justify-content: flex-start;
      align-items: center;
      gap: var(--space-40);
      font-size: var(--fs-20);
      line-height: var(--lh-tight);
      letter-spacing: var(--ls-tight);
      text-transform: capitalize;
      color: var(--text-primary);
    }
    .logo {
      display: flex;
      align-items: center;
    }
    .logo-text {
      width: min-content;
      font-size: var(--fs-16);
      line-height: var(--lh-snug);
      color: var(--text-ink-800);
    }
    .nav {
      display: flex;
      gap: var(--space-32);
    }
    /* Підкреслення з'являється зліва направо при наведенні */
    .nav a,
    .booking {
      position: relative;
    }
    .nav a::after,
    .booking::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -0.15em;
      border-bottom: var(--border-width) solid currentColor;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--duration) var(--ease);
    }
    .nav a:hover::after,
    .nav a:focus-visible::after,
    .booking:hover::after,
    .booking:focus-visible::after {
      transform: scaleX(1);
    }
    .meta {
      display: flex;
      align-items: center;
      gap: var(--space-64);
      margin-left: auto;
    }
    .phone { font-variant-numeric: tabular-nums; }
    .booking {
      display: flex;
      align-items: center;
      gap: var(--space-8);
    }
    .booking-icon {
      width: var(--space-16);
      height: var(--space-16);
    }
  }
</style>
