---
import Layout from '../layouts/Layout.astro';
import Preloader from '../components/ui/Preloader.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import Partners from '../components/sections/Partners.astro';
import Why from '../components/sections/Why.astro';
import Departments from '../components/sections/Departments.astro';
import Services from '../components/sections/Services.astro';
import Optics from '../components/sections/Optics.astro';
import Implant from '../components/sections/Implant.astro';
import Steps from '../components/sections/Steps.astro';
import Results from '../components/sections/Results.astro';
