---
import '../styles/global.css';
import site from '../content/site.json';
import PageTransition from '../components/ui/PageTransition.astro';
import ScrollReveal from '../components/ui/ScrollReveal.astro';
import { withBase } from '../scripts/url';
import fontUrl from '../assets/fonts/PPAlteraCarve-Regular.otf?url';

interface Props {
  title?: string;
}
const { title = site.title } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase(site.ogImage), Astro.site);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <link rel="preload" href={fontUrl} as="font" type="font/otf" crossorigin />
    <title>{title}</title>

    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

    <!-- Прев'ю посилання в соцмережах і месенджерах -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.ogDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <!-- ontouchstart: без нього Safari на iPhone не вмикає :active (підсвітка під час натискання) -->
  <body ontouchstart="">
    <PageTransition />
    <slot />
    <ScrollReveal />
  </body>
</html>
